# Скопируйте в .env и заполните. Это ЕДИНЫЙ env-файл всего проекта, его читают:
#  - docker compose (интерполяция ${...} в docker-compose.yml)
#  - Vite/фронтенд (только переменные с префиксом VITE_)
#  - Go-бэкенд через `npm run backend:dev`
#  - скрипты датасета (scripts/*.ts)

# ============ Go-бэкенд (npm run backend:dev) ============
PORT=8080
# Локальный Postgres из compose (пароль/порт — см. секцию compose ниже):
DATABASE_URL=postgresql://postgres:POSTGRES_PASSWORD@localhost:55432/postgres
# Применять goose-миграции на старте.
AUTO_MIGRATE=true
DATA_DIR=./.data
# Vite-прокси: картинки и OAuth-callback через тот же origin, что и фронт.
PUBLIC_BASE_URL=http://localhost:5173
# Секрет подписи access-JWT (случайная строка, минимум ~32 символа).
AUTH_JWT_SECRET=
# Google OAuth (опционально). Redirect URI в Google Cloud Console:
#   $PUBLIC_BASE_URL/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "true" — показать кнопку Google на форме входа (вшивается в бандл при сборке).
VITE_GOOGLE_AUTH=
# Нужен, только если фронт ходит на API с другого origin (без Vite-прокси/Caddy)
CORS_ALLOWED_ORIGINS=

# ============ LLM (анализ фото + скрипты датасета) ============
OPENROUTER_API_KEY=
SITE_URL=https://bite.fedorresh.ru
SITE_NAME=Bite

# ============ Только для docker compose (VPS / Raspberry Pi) ============
# Домен, который заведён в Dokploy на сервис caddy (порт 80). TLS выпускает
# Traefik из Dokploy, стеку сертификаты не нужны.
DOMAIN=localhost
# Origin для абсолютных URL картинок в БД. По умолчанию https://$DOMAIN —
# задавайте руками, только если ходите по http (например http://192.168.1.50).
# Менять после начала эксплуатации нельзя: старые записи останутся с прежним URL.
APP_ORIGIN=
POSTGRES_PASSWORD=
# Порт Postgres на хосте (для psql/backend:dev вне Docker; 5432 часто занят)
POSTGRES_HOST_PORT=55432
# Часовой пояс контейнеров — от него зависят даты в логах и в бэкапах
TZ=Etc/UTC
# Автобэкап: период в секундах и сколько файлов держать в ./backups
BACKUP_INTERVAL=86400
BACKUP_KEEP=14

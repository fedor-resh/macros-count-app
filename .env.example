# Скопируйте в .env и заполните. Это ЕДИНЫЙ env-файл всего проекта, его читают:
#  - docker compose (интерполяция ${...} в docker-compose.yml)
#  - Vite/фронтенд (только переменные с префиксом VITE_)
#  - Go-бэкенд через `npm run backend:dev`
#  - скрипты датасета (scripts/*.ts)

# ============ Supabase (остаётся только Auth) ============
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Нужен, только если проект на legacy HS256-подписи (Dashboard -> Settings -> API -> JWT Secret).
# При asymmetric signing ключи подтягиваются с JWKS автоматически.
SUPABASE_JWT_SECRET=
# Те же значения для фронта — Vite отдаёт в бандл только VITE_*
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# ============ Go-бэкенд (npm run backend:dev) ============
PORT=8080
# Локальный Postgres из compose (пароль/порт — см. секцию compose ниже):
DATABASE_URL=postgresql://postgres:POSTGRES_PASSWORD@localhost:55432/postgres
# Применять goose-миграции на старте. ТОЛЬКО против своего Postgres,
# никогда — против БД Supabase.
AUTO_MIGRATE=true
# Хранилище картинок: disk (боевой режим) или supabase (переходный, Фаза 1)
STORAGE_DRIVER=disk
DATA_DIR=./.data
PUBLIC_BASE_URL=http://localhost:8080
# Нужен только при STORAGE_DRIVER=supabase
SUPABASE_SERVICE_ROLE_KEY=
# Нужен, только если фронт ходит на API с другого origin (без Vite-прокси/Caddy)
CORS_ALLOWED_ORIGINS=

# ============ LLM (анализ фото + скрипты датасета) ============
OPENROUTER_API_KEY=
SITE_URL=https://macros-count-app.com
SITE_NAME=Bite

# ============ Только для docker compose (VPS / Raspberry Pi) ============
# Адрес, по которому открывают приложение: домен или IP машины в локальной сети.
DOMAIN=localhost
# Откуда Caddy берёт сертификат:
#   internal        — self-signed (LAN, Cloudflare Tunnel, Tailscale)
#   вашmail@...     — Let's Encrypt; нужен публичный домен и открытые 80/443
CADDY_TLS=internal
# Origin для абсолютных URL картинок в БД. По умолчанию https://$DOMAIN —
# задавайте руками, только если ходите по http (например http://192.168.1.50).
# Менять после начала эксплуатации нельзя: старые записи останутся с прежним URL.
APP_ORIGIN=
POSTGRES_PASSWORD=
# Порт Postgres на хосте (для psql/backend:dev вне Docker; 5432 часто занят)
POSTGRES_HOST_PORT=55432
# Часовой пояс контейнеров — от него зависят даты в логах и в бэкапах
TZ=Etc/UTC
# Автобэкап: период в секундах и сколько файлов держать в ./backups
BACKUP_INTERVAL=86400
BACKUP_KEEP=14
# Pooler-URL БД Supabase — нужен ТОЛЬКО для scripts/migrate-db.sh (перенос данных):
# postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

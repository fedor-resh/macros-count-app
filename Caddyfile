# Единый origin: фронтенд, API и картинки за одним доменом и одним TLS.
#
# DOMAIN — адрес, по которому открывают приложение (домен или IP в LAN).
# CADDY_TLS выбирает, откуда брать сертификат:
#   internal          — self-signed от локального CA Caddy. Годится для LAN,
#                       Cloudflare Tunnel и Tailscale, где 80-й порт снаружи
#                       недоступен. Браузер покажет предупреждение.
#   you@example.com   — Let's Encrypt. Нужен публичный домен с A-записью на этот
#                       хост и открытые снаружи порты 80 и 443.
{$DOMAIN:localhost} {
	tls {$CADDY_TLS:internal}

	# route фиксирует порядок: без него порядок handle-блоков определяет Caddy.
	route {
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
		}

		# Живость всего стека снаружи: /healthz отдаёт Go API.
		handle /healthz {
			reverse_proxy api:8080
		}

		# SSE-поток результатов анализа фото. Без сжатия: gzip поверх
		# text/event-stream только добавляет задержку и работу процессору.
		handle /api/v1/events {
			reverse_proxy api:8080 {
				flush_interval -1
			}
		}

		handle /api/* {
			encode zstd gzip
			reverse_proxy api:8080
		}

		# Картинки еды лежат на диске, отдаёт их сам Go API.
		handle /images/* {
			reverse_proxy api:8080
		}

		handle {
			reverse_proxy frontend:8081
		}
	}
}

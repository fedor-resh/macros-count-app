# Единый origin: фронтенд, API и картинки за одним адресом.
#
# Только HTTP на 80: снаружи стоит Traefik из Dokploy, он терминирует TLS и
# ходит сюда по внутренней docker-сети. Второй ACME-клиент рядом с Traefik
# только спорил бы с ним за порты и сертификаты.
:80 {
	# route фиксирует порядок: без него порядок handle-блоков определяет Caddy.
	route {
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
		}

		# Живость всего стека снаружи: /healthz отдаёт Go API.
		handle /healthz {
			reverse_proxy api:8080
		}

		# SSE-поток результатов анализа фото. Без сжатия: gzip поверх
		# text/event-stream только добавляет задержку и работу процессору.
		handle /api/v1/events {
			reverse_proxy api:8080 {
				flush_interval -1
			}
		}

		handle /api/* {
			encode zstd gzip
			reverse_proxy api:8080
		}

		# Картинки еды лежат на диске, отдаёт их сам Go API.
		handle /images/* {
			reverse_proxy api:8080
		}

		handle {
			reverse_proxy frontend:8081
		}
	}
}

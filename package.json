{
	"name": "macros-count-app",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"build": "tsc && vite build",
		"dev": "vite",
		"preview": "vite preview",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"deploy:functions": "supabase functions deploy",
		"gen:types": "npx supabase gen types typescript --project-id gwhqshlpglptxsexagcz --schema public > src/types/database.types.ts",
		"supabase:start": "supabase start",
		"supabase:stop": "supabase stop",
		"supabase:reset": "supabase db reset",
		"backend:dev": "cd backend && dotenv -e ../.env -- go run ./cmd/server",
		"backend:test": "cd backend && go test ./...",
		"db:up": "docker compose up -d postgres",
		"db:down": "docker compose stop postgres",
		"db:logs": "docker compose logs -f postgres",
		"format": "biome format --write",
		"lint": "biome lint --write",
		"typecheck": "tsc --noEmit",
		"dataset:export": "tsx scripts/export-dataset.ts",
		"dataset:classify": "tsx scripts/classify-images.ts",
		"dataset:enrich": "tsx scripts/enrich-features.ts",
		"dataset:predict": "tsx scripts/predict-calories.ts",
		"dataset:metrics": "python scripts/analyze-metrics.py",
		"dataset:training": "python scripts/build-training-dataset.py"
	},
	"dependencies": {
		"@mantine/core": "^8.3.6",
		"@mantine/dates": "^8.3.6",
		"@mantine/form": "^8.3.6",
		"@mantine/hooks": "^8.3.6",
		"@mantine/notifications": "^8.3.6",
		"@microsoft/fetch-event-source": "^2.0.1",
		"@supabase/supabase-js": "^2.45.4",
		"@tabler/icons-react": "^3.17.0",
		"@tanstack/query-async-storage-persister": "^5.90.9",
		"@tanstack/react-query": "^5.56.2",
		"@tanstack/react-query-persist-client": "^5.90.9",
		"camelcase-keys": "^10.0.1",
		"dayjs": "^1.11.13",
		"react": "19.2.0",
		"react-dom": "19.2.0",
		"react-router-dom": "^6.26.2",
		"zustand": "^5.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.2",
		"@ianvs/prettier-plugin-sort-imports": "^4.1.1",
		"@types/react": "^18.3.10",
		"@types/react-dom": "^18.3.0",
		"@typescript-eslint/eslint-plugin": "^8.7.0",
		"@typescript-eslint/parser": "^8.7.0",
		"@vitejs/plugin-react": "^4.3.1",
		"@vitest/coverage-v8": "^2.1.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"dotenv": "^17.3.1",
		"dotenv-cli": "^11.0.0",
		"eslint": "^9.12.0",
		"eslint-plugin-react-hooks": "^5.0.0",
		"eslint-plugin-react-refresh": "^0.4.12",
		"jsdom": "^24.1.1",
		"postcss-preset-mantine": "^1.18.0",
		"prettier": "^3.2.5",
		"supabase": "2.54.11",
		"tsx": "^4.21.0",
		"typescript": "^5.6.2",
		"vite": "^5.4.6",
		"vite-plugin-pwa": "^1.1.0",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^2.1.1"
	}
}
